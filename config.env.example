# ═══════════════════════════════════════════════════════════════════════════════
# ░▒▓ OCI INSTANCE PROVISIONER — CONFIGURATION TEMPLATE ▓▒░
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to `config.env` and populate with your Oracle Cloud details:
#   cp config.env.example config.env
# ═══════════════════════════════════════════════════════════════════════════════

# ─── MANDATORY OCI PARAMETERS ──────────────────────────────────────────────────
# Tenancy or Compartment OCID
# Example: "ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
COMPARTMENT_ID="ocid1.tenancy.oc1..your_tenancy_or_compartment_ocid"

# Public Subnet OCID (Must allow public IPv4 assignment)
# Example: "ocid1.subnet.oc1.ap-mumbai-1.aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SUBNET_ID="ocid1.subnet.oc1.your_region.your_subnet_ocid"

# Availability Domain Name
# Find with: oci iam availability-domain list
# Example: "nGAL:AP-MUMBAI-1-AD-1" or "Uocm:PHX-AD-1"
AVAILABILITY_DOMAIN="your_ad_name_here"

# Operating System Image OCID (Canonical Ubuntu 24.04 aarch64 recommended)
# Find with: oci compute image list --compartment-id $COMPARTMENT_ID --shape VM.Standard.A1.Flex
IMAGE_OCID="ocid1.image.oc1.your_region.your_image_ocid"

# Path to your SSH Public Key (the .pub file will be injected into the VM)
SSH_KEY_PATH="$HOME/.ssh/id_ed25519"

# ─── HARDWARE & SHAPE SPECIFICATIONS (ALWAYS FREE ARM TIER) ────────────────────
SHAPE="VM.Standard.A1.Flex"
OCPU_COUNT=2
MEMORY_GB=12
BOOT_VOLUME_SIZE_GB=200
BOOT_VOLUME_VPUS=10

# ─── TIMING & RATE-LIMIT POLICY (AIMD Self-Tuning) ────────────────────────────
# Base delay between checks in seconds (90s-100s recommended for OCI ARM)
RETRY_BASE=95
RETRY_JITTER=10
MIN_BASE_INTERVAL=85
MAX_BASE_INTERVAL=115

# ─── TELEGRAM NOTIFICATIONS (OPTIONAL) ─────────────────────────────────────────
# Notification engine: 'hermes' (uses Hermes Agent), 'curl' (direct Telegram Bot API), or 'none'
TELEGRAM_ENGINE="none"

# Required only if TELEGRAM_ENGINE="curl":
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Alert Throttling Intervals (seconds)
TELEGRAM_DIGEST_INTERVAL=600  # 10 minutes regular status update
TELEGRAM_429_THROTTLE=300     # 5 minutes throttle on rate limit notices
